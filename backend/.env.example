# ===================================================================
# 环境变量示例文件（技术契约 SPEC §10）
# 使用方式：复制本文件为 .env，按需填写。
#   cp .env.example .env
#
# 【重要】所有 API Key 留空即进入「Mock 模式」：
#   - 不联网、不消耗任何额度，本地确定性生成高质量的任务拆解与执行结果；
#   - 全功能可正常演示，适合面试 / 离线展示；
#   - 一旦填入任意一家的真实 API Key 并将 LLM_PROVIDER 指向对应厂商，
#     系统会自动切换为「真实大模型」模式。
# ===================================================================

# 大模型厂商：可选 openai | qwen(通义千问) | zhipu(智谱) | mock
# 默认 mock。即使填了 openai 但对应 Key 为空，也会回退到 Mock 模式。
LLM_PROVIDER=mock

# --- 各厂商 API Key（按需填写其一；留空即 Mock 模式）---
# OpenAI 官方或兼容接口的密钥
OPENAI_API_KEY=
# 阿里云通义千问（DashScope）密钥
QWEN_API_KEY=
# 智谱 AI（GLM）密钥
ZHIPU_API_KEY=

# 模型名称（留空则按所选 provider 使用内置默认模型）
# 例：openai -> gpt-4o-mini；qwen -> qwen-plus；zhipu -> glm-4
LLM_MODEL=

# 采样温度，0~1，越低越稳定。任务拆解偏确定性，默认 0.3
LLM_TEMPERATURE=0.3

# 后端监听端口，默认 8000
BACKEND_PORT=8000
